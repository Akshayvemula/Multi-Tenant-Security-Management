
# Server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deep_trace

# Generate a long random value for non-demo deployments.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Development seed accounts. Change these outside local development.
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_MANAGER_PASSWORD=ManagerPass123!
SEED_USER_PASSWORD=UserPass123!

